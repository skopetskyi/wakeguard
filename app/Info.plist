<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>WakeGuard</string>
    <key>CFBundleDisplayName</key>
    <string>WakeGuard</string>
    <key>CFBundleIdentifier</key>
    <string>com.skopetskyi.wakeguard</string>
    <!-- Executable keeps the WakeGuardApp name so existing docs/scripts that
         reference `pkill WakeGuardApp` and `pgrep WakeGuardApp` still match. -->
    <key>CFBundleExecutable</key>
    <string>WakeGuardApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Always a regular app: the Dock icon is present whenever WakeGuard runs. -->
    <!-- Refuse a second instance on the Finder/open launch path; the binary also
         enforces this with an flock guard for bare-binary launches. -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>Personal tool — no warranty.</string>
</dict>
</plist>
